# Local Docker Compose configuration.
POSTGRES_DB=job_search_tracker
POSTGRES_USER=job_search_tracker
# Use the same password in both database URLs below.
POSTGRES_PASSWORD=your_password_here
# Host ports; services use their internal ports inside Compose.
POSTGRES_PORT=55432
FRONTEND_PORT=5173
API_PORT=8080
DATABASE_URL=postgresql+psycopg://job_search_tracker:your_password_here@db:5432/job_search_tracker
TEST_DATABASE_URL=postgresql+psycopg://job_search_tracker:your_password_here@db:5432/job_search_tracker_test
